<% layout('layouts/boilerplate') %>

    <!-- Creamos la fila y centramos el contenido con 6 columnas y un empuje de 3 (offset-3) -->
    <div class="row">
        <h1 class="text-center">Nuevo Campamento</h1>

        <div class="col-6 offset-3">
            <form action="/campgrounds" method="POST">

                <!-- mb-3 significa Margin-Bottom 3 (le da espacio abajo para que no se peguen) -->
                <div class="mb-3">
                    <label class="form-label" for="title">Título:</label>
                    <!-- form-control hace que la caja se vea moderna y ocupe el 100% del espacio -->
                    <input class="form-control" type="text" id="title" name="campground[title]" required>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="location">Ubicación:</label>
                    <input class="form-control" type="text" id="location" name="campground[location]" required>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="image">Link de la Imagen:</label>
                    <input class="form-control" type="text" id="image" name="campground[image]" required>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="price">Precio del Campamento:</label>
                    <!-- input-group es un truco para pegar el signo de dólar $ al lado de la caja -->
                    <div class="input-group">
                        <span class="input-group-text" id="price-label">$</span>
                        <input type="text" class="form-control" id="price" placeholder="0.00" aria-label="Precio"
                            name="campground[price]" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="description">Descripción:</label>
                    <textarea class="form-control" type="text" id="description" name="campground[description]"
                        required></textarea>
                </div>

                <div class="mb-3">
                    <!-- Botón verde (success) que ocupa el ancho disponible -->
                    <button class="btn btn-success">Agregar Campamento</button>
                </div>

            </form>

            <a href="/campgrounds">Volver a todos los campamentos</a>
        </div>
    </div>