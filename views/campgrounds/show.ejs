<% layout('layouts/boilerplate') %>

    <script src="https://cdn.maptiler.com/maptiler-sdk-js/v2.0.3/maptiler-sdk.umd.js"></script>
    <link href="https://cdn.maptiler.com/maptiler-sdk-js/v2.0.3/maptiler-sdk.css" rel="stylesheet" />

    <div class="row">
        <div class="col-6">
            <div class="card mb-3">
                <% for(let img of campground.images) { %>
                    <img src="<%= img.url %>" class="card-img-top mb-2" alt="Foto de <%= campground.title %>">
                    <% } %>

                        <div class="card-body">
                            <h5 class="card-title">
                                <%= campground.title %>
                            </h5>
                            <p class="card-text">
                                <%= campground.description %>
                            </p>
                        </div>

                        <ul class="list-group list-group-flush">
                            <li class="list-group-item text-muted">
                                <%= campground.location %>
                            </li>
                            <li class="list-group-item">Sometido por: <%= campground.author.username %>
                            </li>
                            <li class="list-group-item">$<%= campground.price %>/noche</li>
                        </ul>

                        <% if( currentUser && campground.author.equals(currentUser._id)) { %>
                            <div class="card-body">
                                <a class="card-link btn btn-info"
                                    href="/campgrounds/<%=campground._id%>/edit">Editar</a>
                                <form class="d-inline" action="/campgrounds/<%=campground._id%>?_method=DELETE"
                                    method="POST">
                                    <button class="btn btn-danger">Eliminar</button>
                                </form>
                            </div>
                            <% } %>
                                <div class="card-footer text-muted">Hace 2 días</div>
            </div>
        </div>

        <div class="col-6">
            <div id="map" class="mb-3"></div>

            <% if(currentUser){ %>
                <h2>Deja una Reseña 🏕️</h2>
                <form action="/campgrounds/<%= campground._id %>/reviews" method="POST" class="mb-3">
                    <fieldset class="starability-basic">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                            aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>

                    <div class="mb-3">
                        <label class="form-label" for="body">Comentario:</label>
                        <textarea class="form-control" name="review[body]" id="body" cols="30" rows="3"
                            required></textarea>
                    </div>
                    <button class="btn btn-success">Enviar Reseña</button>
                </form>
                <% } %>

                    <h3>Reseñas de los Campistas:</h3>
                    <% for(let review of campground.reviews) { %>
                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <%= review.author.username %>
                                </h5>
                                <p class="starability-result" data-rating="<%= review.rating %>">
                                    Calificación: <%= review.rating %> estrellas
                                </p>
                                <p class="card-text">Comentario: <%= review.body %>
                                </p>

                                <% if( currentUser && review.author.equals(currentUser._id)) {%>
                                    <form
                                        action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        method="POST">
                                        <button class="btn btn-sm btn-danger">Eliminar</button>
                                    </form>
                                    <% } %>
                            </div>
                        </div>
                        <% } %>
        </div>
    </div>

    <script id="campamento-data" type="application/json">
    <%- JSON.stringify(campground) %>
</script>

    <script>
        maptilersdk.config.apiKey = 'boCr8C45JrPT8rop044I';

        const campamentoJson = document.getElementById('campamento-data').textContent;
        const campamento = JSON.parse(campamentoJson);

        const map = new maptilersdk.Map({
            container: 'map',
            style: maptilersdk.MapStyle.STREETS,
            center: campamento.geometry.coordinates,
            zoom: 10
        });

        new maptilersdk.Marker()
            .setLngLat(campamento.geometry.coordinates)
            .setPopup(
                new maptilersdk.Popup({ offset: 25 })
                    .setHTML(`<h5>${campamento.title}</h5><p>${campamento.location}</p>`)
            )
            .addTo(map);
        map.addControl(new maptilersdk.NavigationControl(), 'bottom-right');
    </script>